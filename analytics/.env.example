# URL of the pulseid-backend API, reachable from the analytics *server*
# (this app never calls the backend from the browser — every fetch happens
# in server components/route handlers so the service key below is never
# shipped to the client).
API_INTERNAL_URL=http://localhost:4000

# MUST match the backend's ANALYTICS_SERVICE_KEY exactly. Sent as the
# `x-analytics-key` header on every request to /api/analytics/*. Generate
# with `openssl rand -hex 32`.
ANALYTICS_SERVICE_KEY=change-this-to-a-long-random-string

# Secret this app uses to sign its own analyst session cookie. Independent
# from the doctor/patient SESSION_SECRET on purpose — an analyst account has
# nothing to do with, and should never be swappable for, a clinical login.
ANALYTICS_SESSION_SECRET=change-this-to-a-different-long-random-string

# Named analyst accounts, not a shared password (see lib/analysts.ts) —
# every bulletin approval and audit-log entry needs to say *who*, which a
# single shared password never could. These two vars only matter on first
# run: if no analyst accounts exist yet in the analytics.db SQLite file,
# the app bootstraps exactly one admin account from them. After that,
# manage accounts from the "Analysts" page (admin-only) — add colleagues,
# deactivate people who leave — and change this bootstrap password from
# "Account settings" after your first login. Generate a strong one with
# `openssl rand -base64 24`.
ANALYTICS_ADMIN_EMAIL=admin@health.gov
ANALYTICS_ADMIN_PASSWORD=change-this-password

# Enables the AI features (Ask the data, Alerts briefing, Bulletins,
# Resource suggestions). Set ONE of the two providers below — OpenRouter is
# used automatically if OPENROUTER_API_KEY is set, otherwise Anthropic if
# ANTHROPIC_API_KEY is set. If neither is set, those pages still render —
# the AI portions show a clear "not configured" message instead of failing
# the whole page.

# Option A — OpenRouter (https://openrouter.ai/keys). Gives you a choice of
# many underlying models through one key/bill.
OPENROUTER_API_KEY=
# Verify current model names/pricing at https://openrouter.ai/models.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional — OpenRouter attributes usage to this URL on its dashboard.
OPENROUTER_SITE_URL=http://localhost:3100

# Option B — Anthropic direct (https://console.anthropic.com).
ANTHROPIC_API_KEY=
# Verify the current recommended model at https://docs.claude.com.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Where the bulletins database (generated bulletins + review status) is
# stored. Defaults to ./data next to this app; only change this if you're
# running outside the provided Dockerfile, which already sets it for you.
ANALYTICS_DATA_DIR=

# Cron schedules for `npm run scheduler` (see scripts/scheduler.ts) —
# standard 5-field cron syntax. Defaults: Mondays 06:00 for the weekly
# bulletin, the 1st of the month 06:00 for the monthly one.
BULLETIN_WEEKLY_CRON=0 6 * * 1
BULLETIN_MONTHLY_CRON=0 6 1 * *
